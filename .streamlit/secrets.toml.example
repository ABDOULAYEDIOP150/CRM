# Copier ce fichier en .streamlit/secrets.toml (en local)
# ou coller son contenu dans Streamlit Cloud > App > Settings > Secrets.
# Ne JAMAIS commiter le vrai secrets.toml.

# Mot de passe d'accès à l'application (laisser vide = pas de connexion)
APP_PASSWORD = "choisir-un-mot-de-passe"

# true = remplit une base vide avec des données d'exemple (pratique pour une démo / portfolio)
DEMO_MODE = "true"

# Base PostgreSQL pour garder les données en ligne (Neon, Supabase…).
# Sans cette ligne, l'app utilise SQLite, qui est EFFACÉ à chaque redémarrage sur Streamlit Cloud.
# [database]
# url = "postgresql://utilisateur:motdepasse@hote:5432/crm?sslmode=require"
